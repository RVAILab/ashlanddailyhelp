{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashlanddailyhelp-app",
  "account_id": "19fb633f253233dd6d7b8f4f46d722d3",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "ashlanddailyhelp.com", "custom_domain": true },
    { "pattern": "www.ashlanddailyhelp.com", "custom_domain": true }
  ],
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  // Chat questions cost a model call each, so each connection may ask 10 a minute (Workers rate limiting).
  "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "FEED_BASE_URL": "https://steward.ashlanddailyhelp.com/feed/" }
}
