// Serves the site as committed from Cloudflare's static assets. Deployed by .github/workflows/deploy.yml.
{
  "$schema": "https://unpkg.com/wrangler@4.152.0/config-schema.json",
  "name": "ashlanddailyhelp",
  "account_id": "19fb633f253233dd6d7b8f4f46d722d3",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // No custom domains: ashlanddailyhelp.com belongs to the app Worker (../wrangler.jsonc); two claims race on each deploy.
  // worker.js handles /index.html and paths with no asset; every other path is served straight from the assets.
  "main": "worker.js",
  // Files left out of the upload are listed in .assetsignore.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/index.html"] }
}
